  "formulas": {
    "covariance": "sample daily covariance *252; signed RC=w*(Sigma*w)/sigma_p; q=abs(RC)/sum(abs(RC))",
    "diversification_ratio": "sum(w_i*sigma_i)/sigma_p; long-only",
    "downside_deviation": "sqrt(252 * mean(min(r - ((1+rf)^(1/252)-1),0)^2)); denominator includes ALL observations",
    "growth_active_return": "product(1+r_p)-product(1+r_b)",
    "information_ratio": "252*mean(r_p-r_b)/(sqrt(252)*sample_std(r_p-r_b))",
    "risk_breadth": "100*clip((1/sum(q^2)-1)/(N-1),0,1); N=1 -> 0; zero portfolio volatility -> RC/DR unavailable",
    "sortino": "((product(1+r)^(252/n)-1)-rf)/annual_downside_deviation",
    "zero_downside_or_tracking_error": "Sortino or IR unavailable, not infinity; no perfect score imputation"
  },
